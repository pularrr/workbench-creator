{
  "name": "text-workbench-arch-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/generated-app.test.mjs",
    "test:ui": "node --test tests/knowledge-model-card-section-catalog.test.mjs",
    "test:knowledge": "node --test --test-concurrency=1 tests/knowledge-model*.test.mjs",
    "test:model": "node --test --test-concurrency=1 tests/knowledge-model*.test.mjs",
    "test:reliability": "node --test tests/agent-reliability.test.mjs",
    "test:agents": "node --test tests/agent-workflow.test.mjs && node --test tests/llm-provider.test.mjs && node --test tests/knowledge-agent-tools.test.mjs && npm run test:reliability",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:sites": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build:sites": "vinext build",
    "start:sites": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:import-json": "node scripts/import-runtime-to-postgres.mjs",
    "worker:agent": "tsx server/agent/redis-worker.ts",
    "test:plugin": "node --test tests/plugin-workflow.test.mjs",
    "plugin:discover": "node scripts/knowmap.mjs discover"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@napi-rs/canvas": "^1.0.8",
    "@shadcn/react": "^0.3.0",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "redis": "^5.12.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "文本生成工作台助手架构图谱"
}